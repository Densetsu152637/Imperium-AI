{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window and detached panel windows, the only windows that may call the app's own commands (plugin_approve included)",
  "windows": ["main", "panel-*"],
  "permissions": [
    "allow-open-external",
    "allow-daemon-endpoint",
    "allow-daemon-status",
    "allow-daemon-start",
    "allow-daemon-stop",
    "allow-daemon-restart",
    "allow-daemon-log",
    "allow-daemon-set-keep-running",
    "allow-store-read",
    "allow-store-write",
    "allow-store-folder",
    "allow-save-export",
    "allow-update-status",
    "allow-update-check",
    "allow-update-set-channel",
    "allow-update-set-schedule",
    "allow-update-restart",
    "allow-update-install-now",
    "allow-update-switch-install",
    "allow-plugin-approve",
    "allow-auto-merge-enable",
    "allow-session-erase",
    "core:default",
    "dialog:allow-open",
    "notification:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-always-on-top",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "core:window:allow-outer-position",
    "core:window:allow-inner-size",
    "core:window:allow-scale-factor",
    "core:window:allow-available-monitors"
  ]
}
