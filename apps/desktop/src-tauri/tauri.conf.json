{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Imperium",
  "version": "0.1.0",
  "mainBinaryName": "imperium-desktop",
  "identifier": "io.github.densetsu152637.imperium",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Imperium",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "resources": {
      "../../../policy/": "policy/",
      "../../../pets/": "pets/"
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJEOTdGN0JGREJBRjgyQTAKUldTZ2dxL2J2L2VYdlQvaFJadlRxRUlIcDEvc0dtVXU3OGVndkZBVG40eVlyS0RaNUlzRGZMeGYK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
