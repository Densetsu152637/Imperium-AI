# Monty release the script worker is built from (docs/plans/code-mode.md, C1 "Pinning and supply chain").
# The four crates below are exact pins (`=x.y.z`) in crates/imperium-script-worker and
# crates/imperium-script, all at this one release. Cargo verifies each crates.io checksum against
# Cargo.lock; scripts/ci/check-monty-pin.sh checks that this file, the manifests and the lock agree.
#
# Adopting a release: at least 14 days after publication, except a security fix, which is adopted as
# soon as the escape suite passes on it. An update is a pull request that changes this file, the
# two manifests and Cargo.lock together and reruns the escape suite.
MONTY_VERSION=1.6.0
# crates.io publication date of MONTY_VERSION (the 14-day rule counts from it).
MONTY_PUBLISHED=2026-11-11
MONTY_CHECKSUM_monty=f4f97929e824988444863bed787476e03d7b3d1b21a95c33a9bb31466a67ccd7
MONTY_CHECKSUM_monty_proto=05de4505dd2b0cce62b63dec7b51e6b7a42d1ac42a6932b5b5e30be6f2828916
MONTY_CHECKSUM_monty_types=f5ab5cdd7efd4b4e67630d7f80c4ad4268b1808f9341a0e00aa7c7f5061ebfb7
MONTY_CHECKSUM_monty_alloc=6095ff633e0d890440e7be6b052a170ef399a08ce657e594532471f6c2ebf004
